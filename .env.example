# Required. Use a random value of at least 32 characters.
JWT_SECRET=

# Required. Use a unique password of at least 12 characters.
MASTER_PASSWORD=

# Optional settings
PORT=3001
DATA_DIR=./data
# Set only when the API is called from a different browser origin.
CORS_ORIGIN=

# Leave blank to disable Telegram notifications in test environments.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
